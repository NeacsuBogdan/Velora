{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "outDir": "dist",
    "paths": {
      "@velora/config": ["packages/config/src/index.ts"],
      "@velora/contracts": ["packages/contracts/src/index.ts"],
      "@velora/domain": ["packages/domain/src/index.ts"],
      "@velora/test-utils": ["packages/test-utils/src/index.ts"],
      "@velora/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "vitest.config.ts"]
}
